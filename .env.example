DB_PATH=./data/trocado.db

ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_B64=
ENABLE_BANKING_REDIRECT_URL=http://localhost:8000/connect/enable-banking/callback

# Serve de bearer token do MCP e de password do dashboard (/dashboard/login).
MCP_BEARER_TOKEN=

GEMINI_API_KEY=

